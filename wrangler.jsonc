// Cloudflare Workers config for biteks.ee
// Static site lives in ./public. The contact form's /api/contact endpoint
// (a small Worker script) gets added here in the next step.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biteks",
  // Personal account (siim@biteks.ee). Pinned so a deploy can never land in the work account.
  "account_id": "e02cfb3fb3bbcf88a3d126bb92d8ae59",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
