// Cloudflare Workers config for biteks.ee
// Static site in ./public; src/worker.js only runs for /api/* (the contact form).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biteks",
  // Personal account (siim@biteks.ee). Pinned so a deploy can never land in the work account.
  "account_id": "e02cfb3fb3bbcf88a3d126bb92d8ae59",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // At most 3 contact messages per visitor IP per minute.
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Secret (not in this file): RESEND_API_KEY, set with `npm run cf -- secret put RESEND_API_KEY`
}
